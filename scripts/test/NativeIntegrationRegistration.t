unlike( $Styles, qr/WorkordersToGroupToggle|WorkordersToGroupPopup/, 'toolbar styles contain no quick-list button or popup' );
like( $Styles, qr/WorkordersToGroupList button\.WorkordersToGroupSort\s*\{\s*border:\s*none;/, 'sortable table headings have no button border' );
