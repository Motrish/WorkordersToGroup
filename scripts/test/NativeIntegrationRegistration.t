like( $SysConfig, qr{Core\.Agent\.WorkordersToGroupToolbar\.js}, 'toolbar availability script is loaded globally' );
like( $SysConfig, qr{Core\.Agent\.WorkordersToGroup\.css}, 'toolbar and table styles are registered' );
like( $SysConfig, qr/Loader::Module::AgentWorkordersToGroupManage/, 'group action popup styles are loaded' );
