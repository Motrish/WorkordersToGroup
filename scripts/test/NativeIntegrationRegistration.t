like( $Styles, qr/\.DataTable\.WorkordersToGroupList\s*\{\s*width:\s*max-content;\s*max-width:\s*100%;/, 'overview table uses content width capped at its available width' );
like( $Toolbar, qr/Icon\.classList\.toggle\('HasAvailableWorkOrders', Number\.isFinite\(Count\) && Count > 0\)/, 'toolbar availability class is applied directly to its users icon' );
like( $ListJS, qr/data-filter-toggle[\s\S]*?SetFilterOpen\(Input, true\)[\s\S]*?if \(!Input\.value\.trim\(\)\)[\s\S]*?SetFilterOpen\(Input, false\)/, 'magnifier opens a live filter and an empty field closes on blur' );
like( $Manifest, qr{var/httpd/htdocs/js/Core\.Agent\.WorkordersToGroupToolbar\.js}, 'toolbar script is in the install package' );
like( $Manifest, qr{var/httpd/htdocs/skins/Agent/default/css/Core\.Agent\.WorkordersToGroup\.css}, 'stylesheet is installed in the OTOBO agent skin path' );
like( $Selector, qr/Form\.querySelector\('input\[name="Action"\]'\)/, 'popup action is read from the native hidden form field' );
like( $Selector, qr/window\.location\.search\.replace\(\/;\/g, '&'\)/, 'OTOBO semicolon-separated query parameters are normalized' );
like( $Selector, qr/Form\.querySelector\('\[name="WorkOrderID"\]'\)/, 'work order ID is read from the native hidden form field' );
