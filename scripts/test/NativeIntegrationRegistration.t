like( $Styles, qr/WorkordersToGroupStateDot\.yellowled\s*\{\s*background-color:\s*#ffdd50;/, 'state dots have explicit colors in the agent theme' );
like( $Assignment, qr/AND \(a\.change_time \$Operator \? OR \(a\.change_time = \? AND a\.id \$Operator \?\)\)/, 'database list supports keyset pagination predicates' );
like( $ClaimController, qr/my \$ResultHash = ref \$Result eq 'HASH'/, 'claim controller guards non-hash service results' );
like( $TargetController, qr/ref \$Result eq 'HASH' && \$Result->\{Code\}/, 'target controller guards non-hash service results' );
like( $AdminTemplate, qr/No groups are enabled for Work Order assignment/, 'admin page explains an empty allowlist' );
like( $Selector, qr/NoAssignableGroupsLabel/, 'native dropdown explains an empty group allowlist' );
unlike( $TargetController . $ToolbarModule . $Assignment, qr/Kernel::System::Config/, 'no invalid Kernel::System::Config object references remain' );
like( $Toolbar, qr/HasAvailableWorkOrders/, 'toolbar script marks availability without interrupting native navigation' );
like( $ClaimController, qr/Param\s*=>\s*'Ajax'/, 'claim endpoint supports the toolbar response' );
