like( $ToolbarModule, qr/Get\('Kernel::Config'\)/, 'global toolbar reads its frontend configuration from OTOBO Kernel::Config' );
like( $Assignment, qr/Get\('Kernel::Config'\)->Get\(/, 'server-side target update reads native permissions from OTOBO Kernel::Config' );
like( $Assignment, qr/GROUP_NOT_ASSIGNABLE/, 'service methods enforce the server-side group allowlist' );
like( $Migration, qr/AssignableGroupIDs\(\)[\s\S]*?GROUP_NOT_ASSIGNABLE/, 'migration preview applies the same group allowlist as assignment' );
unlike( _Read("$Root/Kernel/Modules/AdminWorkordersToGroup.pm"), qr/Limit\s*=>\s*10000/, 'admin migration no longer reports success after a fixed 10,000-row batch' );
like( $Assignment, qr/TTL\s*=>\s*30/, 'global badge count cache uses a short expiry' );
like( $Assignment, qr/CleanUp\( Type => 'WorkordersToGroupCount' \)/, 'assignment changes invalidate cached badge counts' );
like( $Manifest, qr/wotg_assignment_unassigned/, 'assignment table defines a composite claim-list index' );
