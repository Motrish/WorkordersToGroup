like( $Styles, qr/WorkordersToGroupList button\.WorkordersToGroupFilterToggle\s*\{[^}]*border:\s*none;[^}]*background-color:\s*#0000;/, 'magnifier buttons have no border or background' );
like( $Styles, qr/WorkordersToGroupList thead input\[data-filter-column\]\s*\{[^}]*position:\s*static;[^}]*display:\s*inline-block;[^}]*flex:\s*0 1 8rem;/, 'filter input opens inline beside its magnifier instead of overlaying table rows' );
unlike( $Styles, qr/WorkordersToGroupList thead input\[data-filter-column\]\s*\{[^}]*position:\s*absolute;/, 'filter is no longer a floating popup below the table header' );
like( $Styles, qr/\.WorkordersToGroupPillButton\s*\{[^}]*min-height:\s*10px;[^}]*padding:\s*2px 6px 3px;[^}]*line-height:\s*12px;[^}]*vertical-align:\s*middle;[^}]*color:\s*white;[^}]*font-size:\s*11px;[^}]*border:\s*1px solid var\(--colMainLight\);[^}]*background-color:\s*var\(--colMainLight\);[^}]*border-bottom:\s*none;[^}]*cursor:\s*pointer;[^}]*position:\s*relative;[^}]*border-radius:\s*20px;/, 'compact button class implements the requested pill styling' );
