like( $SysConfig, qr/Frontend::ToolBarModule###105-WorkordersToGroup::GroupWorkOrders/, 'claim counter uses the native toolbar extension' );
like( $SysConfig, qr/WorkordersToGroup::AssignableGroups/, 'explicit assignable-group allowlist is configured in SysConfig' );
