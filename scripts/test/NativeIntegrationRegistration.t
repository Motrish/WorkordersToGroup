like( $Manifest, qr/CodeUpgrade Type="post" Version="0\.2\.13"[\s\S]*?wotg_assignment_unassigned[\s\S]*?sys\.indexes/, 'current installations repair the composite index idempotently across database backends' );
like( $Manifest, qr/CodeUpgrade Type="post" Version="0\.2\.13"[\s\S]*?var\/httpd\/htdocs\/css\/Core\.Agent\.WorkordersToGroup\.css[\s\S]*?FileDelete/, 'upgrade removes the obsolete stylesheet path from earlier package versions' );
like( $AgentTemplate, qr/CursorDirection=next;CursorChangeTime=/, 'overview uses cursor pagination links' );
like( $AgentTemplate, qr/Translate\(WorkOrder\.WorkOrderState\)/, 'overview translates configured Work Order state names' );
like( $AgentTemplate, qr/WorkOrder\.ChangeNumber \| html %\]-\[% WorkOrder\.WorkOrderNumber \| html %\][\s\S]*?WorkOrder\.WorkOrderTitle \| html/, 'overview displays change number, Work Order number, and title' );
unlike( $AgentTemplate, qr/WorkOrder\.WorkOrderTitle \| html %\]\s*\(\[% WorkOrder\.WorkOrderID/, 'overview does not expose the internal Work Order ID in its label' );
